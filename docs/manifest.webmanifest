{
  "name": "RK Document — .rkf editor",
  "short_name": ".rkf",
  "description": "Create, edit and read .rkf documents: Markdown with its images embedded in one file. Runs entirely in your browser.",
  "id": "rkformat-editor",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#16161a",
  "theme_color": "#2c5aa0",
  "orientation": "any",
  "icons": [
    {
      "src": "assets/icons/rkf-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/icons/rkf-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/icons/rkf-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "file_handlers": [
    {
      "action": "./",
      "name": "RK Document",
      "accept": {
        "application/vnd.rkformat+zip": [".rkf", ".rk"]
      },
      "icons": [
        {
          "src": "assets/icons/rkf-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ],
      "launch_type": "single-client"
    }
  ]
}
